# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/truetrace?retryWrites=true&w=majority

# ── Upstash Redis ─────────────────────────────────────────────
# Get from: https://console.upstash.com → Redis → Connect
UPSTASH_REDIS_URL=rediss://default:<password>@<host>.upstash.io:6380

# ── CORS ──────────────────────────────────────────────────────
# Your Next.js frontend URL (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
